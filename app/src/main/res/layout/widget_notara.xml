<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:id="@+id/widget_info_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingEnd="10dp">

        <TextView
            android:id="@+id/widget_app_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NOTARA"
            android:textColor="#E8A864"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ketuk untuk memutar"
            android:textColor="#F6EFE6"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Notara Local Audio"
            android:textColor="#B5A698"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_btn_prev"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_btn_secondary"
        android:contentDescription="Previous"
        android:src="@android:drawable/ic_media_previous"
        android:tint="#F6EFE6" />

    <ImageButton
        android:id="@+id/widget_btn_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_btn_primary"
        android:contentDescription="Play or Pause"
        android:src="@android:drawable/ic_media_play"
        android:tint="#23160A" />

    <ImageButton
        android:id="@+id/widget_btn_next"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_btn_secondary"
        android:contentDescription="Next"
        android:src="@android:drawable/ic_media_next"
        android:tint="#F6EFE6" />

</LinearLayout>
